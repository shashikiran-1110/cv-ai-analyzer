# AI is normally configured in the app's UI ("AI settings"): the key stays in your browser.
# Optional server-side fallback so nobody has to enter a key:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# AI_PROVIDER=openai          # force one when both keys are set
