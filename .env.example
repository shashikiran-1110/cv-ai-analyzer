# ---- server & security ----
# PUBLIC_URL=https://cvmatch.example.com       # used in sign-in links and digests
COOKIE_SECURE=true                              # set false only for plain-http local use
HSTS=false                                      # true behind HTTPS
TRUST_FORWARDED=false                           # true behind a trusted reverse proxy (X-Forwarded-For)
LOG_FORMAT=json                                 # json | text
METRICS_TOKEN=                                  # protects GET /metrics and /api/admin/* when set
SCHEDULER=on                                    # watches + source canaries in this process (off on extra replicas)
CANARY_INTERVAL_SECONDS=3600

# ---- data ----
# DATABASE_URL=sqlite:////data/app.db           # default in the image; compose sets Postgres
ANON_RETENTION_DAYS=7
USER_RETENTION_DAYS=365
SEARCH_CACHE_TTL=1800

# ---- email (magic links, digests); without SMTP the link is logged ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CV Match Analyzer <no-reply@example.com>
DEV_LOGIN_LINKS=false                           # true shows sign-in links in the UI (local/demo only)

# ---- AI (users normally bring their own key in the browser) ----
ALLOW_SERVER_KEY_ANON=false                     # never true on a public server
# OPENAI_API_KEY= / ANTHROPIC_API_KEY=
RATE_LIMIT_AI_PER_DAY_USD=2.00                  # daily budget for the server key
# LLM_TIER_FAST= / LLM_TIER_STANDARD= / LLM_TIER_FRONTIER=
# LLM_PRICES={"gpt-5.6-luna": [in, out, cache_read, cache_write]}   # $/MTok for cost display

# ---- rate limits (per client per hour) ----
RATE_LIMIT_SEARCH_PER_HOUR=30
RATE_LIMIT_AI_PER_HOUR=120
RATE_LIMIT_UPLOAD_PER_HOUR=60
RATE_LIMIT_AUTH_PER_HOUR=10

# ---- matching ----
EMBEDDINGS=auto                                 # auto | fastembed | hash
# EMBED_MODEL=BAAI/bge-small-en-v1.5
